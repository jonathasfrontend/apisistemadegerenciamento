// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// ENUMS
// =============================================

enum CommissionType {
  PERCENT
  FIXED
  TABLE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  PIX
  LINK
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  CANCELLED
}

enum NotificationType {
  CONFIRMATION
  REMINDER_24H
  REMINDER_1H
  CANCELLATION
  PROMOTION
  BIRTHDAY
  REACTIVATION
  NO_SHOW
  NEW_USER
  NEW_STAFF
  NEW_PRODUCT
  LOW_STOCK
  PAYMENT_PENDING
  PAYMENT_PAID
  APPOINTMENT_STARTING
  EXPENSE_OVERDUE
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

// F1 (spec §5.2): enums do módulo financeiro. F2/F3 ficam de fora.
enum BankAccountType {
  CHECKING
  SAVINGS
  PAYMENT_ACCOUNT
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SALE
  SUPPLY
  WITHDRAWAL
  EXPENSE
  REFUND
  ADJUSTMENT
}

enum CashDirection {
  IN
  OUT
}

enum RecurrenceInterval {
  WEEKLY
  MONTHLY
  YEARLY
}

enum EntrySource {
  MANUAL
  RECURRING
  BANK_RECONCILIATION
}

// =============================================
// FASE 2 — Importação OFX + conciliação
// (spec FINANCEIRO_IMPLEMENTACAO.md §7, linhas 444-457)
// =============================================

enum ImportKind {
  BANK_STATEMENT
  CREDIT_CARD_INVOICE
}

enum ImportFormat {
  OFX
  PDF
}

enum ImportStatus {
  UPLOADED
  PROCESSING
  READY
  NEEDS_REVIEW
  CONFIRMED
  FAILED
  DISCARDED
}

enum BalanceCheck {
  OK
  MISMATCH
  UNAVAILABLE
}

enum BankTxSource {
  OFX
  PDF
  MANUAL
}

enum BankTxMethod {
  PIX
  TED
  DOC
  BOLETO
  CARD_SETTLEMENT
  FEE
  INTEREST
  CASH_DEPOSIT
  OTHER
}

enum ReconStatus {
  PENDING
  SUGGESTED
  PARTIAL
  RECONCILED
  IGNORED
}

enum ReconTargetType {
  PAYMENT
  CARD_RECEIVABLE
  EXPENSE
  OTHER_INCOME
  CASH_MOVEMENT
  CARD_INVOICE
  TRANSFER
}

enum ReconOrigin {
  AUTO
  RULE
  MANUAL
}

enum RuleMatchType {
  CONTAINS
  STARTS_WITH
  REGEX
}

enum RuleDirection {
  IN
  OUT
  ANY
}

enum RuleAction {
  SET_CATEGORY
  CREATE_ENTRY
  IGNORE
}

// =============================================
// AUTHENTICATION & USERS
// =============================================

// Fase 0 (F0.2): multiempresa mínimo — ver FINANCEIRO_IMPLEMENTACAO.md §5.2
model Company {
  id        String   @id @default(uuid())
  name      String
  document  String? // CNPJ
  timezone  String   @default("America/Sao_Paulo")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users               User[]
  payments            Payment[]
  expenses            Expense[]
  sales               Sale[]
  // 0B.1: relações inversas dos modelos que passam a ser tenant-scoped.
  refreshTokens       RefreshToken[]
  staff               Staff[]
  clients             Client[]
  services            Service[]
  appointments        Appointment[]
  commissions         Commission[]
  products            Product[]
  stockMovements      StockMovement[]
  saleItems           SaleItem[]
  notifications       Notification[]
  reviews             Review[]
  auditLogs           AuditLog[]
  waitlist            Waitlist[]
  // F1: relações inversas do módulo financeiro
  financeSettings     FinanceSettings?
  financialCategories FinancialCategory[]
  suppliers           Supplier[]
  bankAccounts        BankAccount[]
  acquirers           Acquirer[]
  cashRegisters       CashRegister[]
  cashSessions        CashSession[]
  cashMovements       CashMovement[]
  otherIncomes        OtherIncome[]
  cardReceivables     CardReceivable[]
  // F2: import OFX + conciliação
  importBatches       ImportBatch[]
  bankTransactions    BankTransaction[]
  reconciliations     Reconciliation[]
  reconciliationRules ReconciliationRule[]

  @@map("companies")
}

model User {
  id           String    @id @default(uuid())
  email        String // 0B.1: unique composto [companyId, email] abaixo (D-0B.3)
  passwordHash String    @map("password_hash")
  name         String
  roleId       String?   @map("role_id")
  companyId    String // F0.2: NOT NULL após backfill (etapa 2)
  isActive     Boolean   @default(true) @map("is_active")
  phone        String?
  avatar       String?
  lastLogin    DateTime? @map("last_login")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company              Company        @relation(fields: [companyId], references: [id])
  role                 Role?          @relation(fields: [roleId], references: [id])
  refreshTokens        RefreshToken[]
  staff                Staff?
  auditLogs            AuditLog[]
  createdAppointments  Appointment[]  @relation("CreatedBy")
  notifications        Notification[]
  // F1: relações inversas de caixa (quem abriu/fechou, quem criou/anulou movimento)
  cashSessionsOpened   CashSession[]  @relation("CashSessionOpenedBy")
  cashSessionsClosed   CashSession[]  @relation("CashSessionClosedBy")
  cashMovementsCreated CashMovement[] @relation("CashMovementCreatedBy")
  cashMovementsVoided  CashMovement[] @relation("CashMovementVoidedBy")
  // F2: quem enviou / confirmou o lote de importação
  importBatches        ImportBatch[]   @relation("ImportUploadedBy")
  importBatchesConfirmed ImportBatch[] @relation("ImportConfirmedBy")

  @@unique([companyId, email])
  @@index([roleId])
  @@index([companyId])
  @@map("users")
}

// =============================================
// ROLES & PERMISSIONS
// =============================================

model Role {
  id          String  @id @default(uuid())
  name        String  @unique // "Admin", "Recepção", "Cabeleireiro", etc.
  description String? @db.Text
  isSystem    Boolean @default(false) @map("is_system") // Roles de sistema não podem ser deletadas
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique // "clients.read", "clients.create", "appointments.create", etc.
  description String? @db.Text
  module      String // "clients", "appointments", "staff", "reports", etc.

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  companyId String // 0B.1: tenant-scoped
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// =============================================
// STAFF (PROFISSIONAIS)
// =============================================

model Staff {
  id              String         @id @default(uuid())
  userId          String         @unique @map("user_id")
  specialties     String[] // ["manicure", "cabelo", "maquiagem"]
  commissionType  CommissionType @default(PERCENT) @map("commission_type")
  commissionValue Float          @default(0) @map("commission_value")
  workSchedule    Json?          @map("work_schedule") // { "monday": { "start": "09:00", "end": "18:00" }, ... }
  blockedDates    Json?          @map("blocked_dates") // [{ "start": "2024-12-25", "end": "2024-12-26", "reason": "férias" }]
  isAvailable     Boolean        @default(true) @map("is_available")
  companyId       String // 0B.1: tenant-scoped

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company       @relation(fields: [companyId], references: [id])
  appointments Appointment[]
  commissions  Commission[]

  @@index([userId])
  @@index([companyId])
  @@map("staff")
}

// =============================================
// CLIENTS
// =============================================

model Client {
  id            String    @id @default(uuid())
  companyId     String // 0B.1: tenant-scoped
  name          String
  phone         String // 0B.1: unique composto [companyId, phone] (D-0B.3)
  email         String?
  birthdate     DateTime?
  cpf           String? // 0B.1: unique composto [companyId, cpf] (D-0B.3)
  notes         String?   @db.Text
  preferences   Json? // { "preferredStaff": "uuid", "allergies": ["látex"], "favoriteColor": "#FF0000" }
  loyaltyPoints Int       @default(0) @map("loyalty_points")
  noShowCount   Int       @default(0) @map("no_show_count")
  isBlocked     Boolean   @default(false) @map("is_blocked")
  consentLGPD   Boolean   @default(false) @map("consent_lgpd")
  consentDate   DateTime? @map("consent_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company      Company       @relation(fields: [companyId], references: [id])
  appointments Appointment[]
  payments     Payment[]
  sales        Sale[]
  reviews      Review[]

  @@unique([companyId, phone])
  @@unique([companyId, cpf])
  @@index([companyId])
  @@index([phone])
  @@index([email])
  @@map("clients")
}

// =============================================
// SERVICES
// =============================================

model Service {
  id              String  @id @default(uuid())
  companyId       String // 0B.1: tenant-scoped
  name            String
  description     String? @db.Text
  durationMinutes Int     @map("duration_minutes")
  price           Float
  category        String // "cabelo", "unha", "estética", "maquiagem"
  isActive        Boolean @default(true) @map("is_active")
  allowsCombo     Boolean @default(true) @map("allows_combo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([category])
  @@map("services")
}

// =============================================
// APPOINTMENTS (AGENDAMENTOS)
// =============================================

model Appointment {
  id          String            @id @default(uuid())
  companyId   String // 0B.1: tenant-scoped
  clientId    String            @map("client_id")
  staffId     String            @map("staff_id")
  startTime   DateTime          @map("start_time")
  endTime     DateTime          @map("end_time")
  status      AppointmentStatus @default(SCHEDULED)
  services    Json // [{ "id": "uuid", "name": "Corte", "price": 50, "duration": 30 }]
  totalAmount Float             @default(0) @map("total_amount")
  notes       String?           @db.Text
  isPaid      Boolean           @default(false) @map("is_paid")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  client        Client         @relation(fields: [clientId], references: [id])
  staff         Staff          @relation(fields: [staffId], references: [id])
  creator       User           @relation("CreatedBy", fields: [createdBy], references: [id])
  company       Company        @relation(fields: [companyId], references: [id])
  payments      Payment[]
  notifications Notification[]

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([startTime])
  @@index([staffId, startTime])
  @@index([clientId])
  @@index([status])
  @@map("appointments")
}

// =============================================
// PAYMENTS & FINANCE
// =============================================

model Payment {
  id               String        @id @default(uuid())
  companyId        String // F0.2: NOT NULL após backfill (etapa 2)
  appointmentId    String?       @map("appointment_id")
  clientId         String        @map("client_id")
  amount           Float
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  gatewayReference String?       @map("gateway_reference")
  gatewayResponse  Json?         @map("gateway_response")
  paidAt           DateTime?     @map("paid_at")

  // F1: vínculos com caixa/conta/adquirente/venda + conciliação (spec §5.1)
  saleId        String?
  bankAccountId String?
  acquirerId    String?
  cashSessionId String?
  installments  Int         @default(1)
  feeAmount     Decimal?    @db.Decimal(14, 2)
  netAmount     Decimal?    @db.Decimal(14, 2)
  isReconciled  Boolean     @default(false)
  reconciledAt  DateTime?
  canceledAt    DateTime?
  source        EntrySource @default(MANUAL)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company         Company          @relation(fields: [companyId], references: [id])
  appointment     Appointment?     @relation(fields: [appointmentId], references: [id])
  client          Client           @relation(fields: [clientId], references: [id])
  commissions     Commission[]
  sale            Sale?            @relation(fields: [saleId], references: [id])
  bankAccount     BankAccount?     @relation(fields: [bankAccountId], references: [id])
  acquirer        Acquirer?        @relation(fields: [acquirerId], references: [id])
  cashSession     CashSession?     @relation(fields: [cashSessionId], references: [id])
  cardReceivables CardReceivable[]
  cashMovement    CashMovement?
  // F2: conciliações deste pagamento
  reconciliations Reconciliation[]

  @@index([companyId, status])
  @@index([companyId, bankAccountId])
  @@index([companyId, cashSessionId])
  @@index([companyId, acquirerId, isReconciled])
  @@index([appointmentId])
  @@index([clientId])
  @@index([saleId])
  @@index([status])
  @@map("payments")
}

model Commission {
  id        String    @id @default(uuid())
  companyId String // 0B.1: tenant-scoped
  paymentId String    @map("payment_id")
  staffId   String    @map("staff_id")
  amount    Float
  isPaid    Boolean   @default(false) @map("is_paid")
  paidAt    DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([staffId])
  @@index([paymentId])
  @@map("commissions")
}

model Expense {
  id          String    @id @default(uuid())
  companyId   String // F0.2: NOT NULL após backfill (etapa 2)
  description String
  category    String // legado mantido (spec §5.1) — migrate-expense-categories preenche categoryId
  amount      Float
  dueDate     DateTime  @map("due_date")
  paidDate    DateTime? @map("paid_date")
  isPaid      Boolean   @default(false) @map("is_paid")
  isRecurring Boolean   @default(false) @map("is_recurring")
  notes       String?   @db.Text

  // F1: a pagar (spec §5.1). category/bankAccount String legados preservados.
  categoryId         String?
  supplierId         String?
  paidAmount         Decimal?            @db.Decimal(14, 2)
  paymentMethod      PaymentMethod?
  bankAccountId      String?
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?
  recurrenceInterval RecurrenceInterval?
  recurrenceEndsAt   DateTime?           @db.Date
  recurrenceParentId String?
  canceledAt         DateTime?
  source             EntrySource         @default(MANUAL)
  isReconciled       Boolean             @default(false)
  reconciledAt       DateTime?

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  company            Company            @relation(fields: [companyId], references: [id])
  financialCategory  FinancialCategory? @relation(fields: [categoryId], references: [id])
  supplier           Supplier?          @relation(fields: [supplierId], references: [id])
  bankAccount        BankAccount?       @relation(fields: [bankAccountId], references: [id])
  recurrenceParent   Expense?           @relation("ExpenseRecurrence", fields: [recurrenceParentId], references: [id])
  recurrenceChildren Expense[]          @relation("ExpenseRecurrence")
  cashMovement       CashMovement?
  // F2: conciliações desta despesa
  reconciliations    Reconciliation[]

  @@unique([recurrenceParentId, dueDate])
  @@index([companyId, isPaid, dueDate])
  @@index([companyId, bankAccountId])
  @@index([companyId, installmentGroupId])
  @@index([dueDate])
  @@index([category])
  @@index([categoryId])
  @@index([supplierId])
  @@map("expenses")
}

// =============================================
// PRODUCTS & INVENTORY
// =============================================

model Product {
  id               String  @id @default(uuid())
  companyId        String // 0B.1: tenant-scoped
  sku              String // 0B.1: unique composto [companyId, sku] (D-0B.3)
  name             String
  description      String? @db.Text
  category         String
  quantity         Int     @default(0)
  costPrice        Float   @map("cost_price")
  salePrice        Float   @map("sale_price")
  reorderThreshold Int     @default(10) @map("reorder_threshold")
  supplier         String?
  isActive         Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company        Company         @relation(fields: [companyId], references: [id])
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([sku])
  @@index([category])
  @@map("products")
}

model StockMovement {
  id        String  @id @default(uuid())
  companyId String // 0B.1: tenant-scoped
  productId String  @map("product_id")
  type      String // "IN" | "OUT" | "ADJUSTMENT"
  quantity  Int
  reason    String?
  reference String? // nota fiscal, venda ID, etc

  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([productId])
  @@map("stock_movements")
}

// =============================================
// SALES (PDV)
// =============================================

model Sale {
  id            String        @id @default(uuid())
  companyId     String // F0.2: NOT NULL após backfill (etapa 2)
  clientId      String?       @map("client_id")
  totalAmount   Float         @map("total_amount")
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(PAID) @map("payment_status")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  company  Company    @relation(fields: [companyId], references: [id])
  client   Client?    @relation(fields: [clientId], references: [id])
  items    SaleItem[]
  payments Payment[] // F1 (decisão 4A): Payment.saleId

  @@index([companyId])
  @@index([clientId])
  @@map("sales")
}

model SaleItem {
  id        String @id @default(uuid())
  companyId String // 0B.1: tenant-scoped
  saleId    String @map("sale_id")
  productId String @map("product_id")
  quantity  Int
  unitPrice Float  @map("unit_price")
  total     Float

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// =============================================
// NOTIFICATIONS
// =============================================

model Notification {
  id            String              @id @default(uuid())
  companyId     String // 0B.1: tenant-scoped
  userId        String?             @map("user_id")
  appointmentId String?             @map("appointment_id")
  // Rota interna para onde o clique na notificação leva (/appointments/{id}, ...)
  link          String?             @map("link")
  // Chave do evento (ex.: "LOW_STOCK:{produtoId}:{timestamp}") — garante 1
  // registro por usuário por evento, mesmo com corrida entre worker e reconciliador
  dedupeKey     String?             @map("dedupe_key")
  type          NotificationType
  channel       NotificationChannel
  recipient     String // phone or email
  message       String              @db.Text
  status        NotificationStatus  @default(PENDING)
  readAt        DateTime?           @map("read_at")
  scheduledFor  DateTime?           @map("scheduled_for")
  sentAt        DateTime?           @map("sent_at")
  errorMessage  String?             @map("error_message") @db.Text
  attempts      Int                 @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  user        User?        @relation(fields: [userId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  company     Company      @relation(fields: [companyId], references: [id])

  @@unique([userId, dedupeKey])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([userId])
  @@index([appointmentId])
  @@index([status])
  @@index([scheduledFor])
  @@map("notifications")
}

// =============================================
// REVIEWS & FEEDBACK
// =============================================

model Review {
  id             String  @id @default(uuid())
  companyId      String // 0B.1: tenant-scoped
  clientId       String  @map("client_id")
  rating         Int // 1-5
  comment        String? @db.Text
  serviceQuality Int?    @map("service_quality")
  staffBehavior  Int?    @map("staff_behavior")
  cleanliness    Int?

  createdAt DateTime @default(now()) @map("created_at")

  client  Client  @relation(fields: [clientId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([clientId])
  @@map("reviews")
}

// =============================================
// AUDIT & SECURITY
// =============================================

model AuditLog {
  id        String  @id @default(uuid())
  companyId String // 0B.1: tenant-scoped
  userId    String? @map("user_id")
  action    String // "CREATE", "UPDATE", "DELETE", "LOGIN", "LOGOUT"
  entity    String // "appointment", "payment", "user"
  entityId  String? @map("entity_id")
  payload   Json?
  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  user    User?   @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================
// WAITLIST (LISTA DE ESPERA)
// =============================================

model Waitlist {
  id            String    @id @default(uuid())
  companyId     String // 0B.1: tenant-scoped
  clientName    String    @map("client_name")
  clientPhone   String    @map("client_phone")
  serviceId     String    @map("service_id")
  preferredDate DateTime? @map("preferred_date")
  notes         String?   @db.Text
  isContacted   Boolean   @default(false) @map("is_contacted")

  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([isContacted])
  @@map("waitlist")
}

// =============================================
// F1 — MÓDULO FINANCEIRO (Fase 1)
// Fonte: FINANCEIRO_IMPLEMENTACAO.md §5.2 + Apêndice B.
// Modelos F2/F3 (Reconciliation, BankTransaction, ImportBatch, CreditCard)
// ficam FORA: relações inversas que os citam foram omitidas de propósito.
// =============================================

model FinanceSettings {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  requireOpenCashSession Boolean @default(true)
  cashClosingTolerance   Decimal @default(0) @db.Decimal(14, 2)
  matchWindowDays        Int     @default(3)
  autoConfirmScore       Int?
  cardTolerancePct       Decimal @default(1.5) @db.Decimal(5, 2)
  fileRetentionDays      Int     @default(30)
  enableOverdueAlerts    Boolean @default(true) // F1 Task 9: job de vencimento

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("finance_settings")
}

model FinancialCategory {
  id         String              @id @default(uuid())
  companyId  String
  company    Company             @relation(fields: [companyId], references: [id])
  name       String
  kind       CategoryKind
  parentId   String?
  parent     FinancialCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   FinancialCategory[] @relation("CategoryTree")
  color      String?
  isSystem   Boolean             @default(false)
  systemCode String?
  isActive   Boolean             @default(true)
  sortOrder  Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses      Expense[]
  otherIncomes  OtherIncome[]
  cashMovements CashMovement[]
  // F2: categoria atribuída a uma transação bancária / regra
  bankTransactions    BankTransaction[]
  reconciliationRules ReconciliationRule[]

  @@unique([companyId, kind, name])
  @@index([companyId, kind, isActive])
  @@map("financial_categories")
}

model Supplier {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  document  String?
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
  // F2: regras de conciliação que apontam para este fornecedor
  reconciliationRules ReconciliationRule[]

  @@index([companyId, isActive])
  @@map("suppliers")
}

model BankAccount {
  id                 String          @id @default(uuid())
  companyId          String
  company            Company         @relation(fields: [companyId], references: [id])
  name               String
  bankCode           String?
  bankName           String?
  agency             String?
  accountNumber      String?
  type               BankAccountType @default(CHECKING)
  ofxBankId          String?
  ofxAccountId       String?
  initialBalance     Decimal         @default(0) @db.Decimal(14, 2)
  initialBalanceDate DateTime        @db.Date
  color              String?
  isActive           Boolean         @default(true)
  // F2: última importação processada nesta conta
  lastImportAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments      Payment[]
  expenses      Expense[]
  cashMovements CashMovement[]
  otherIncomes  OtherIncome[]
  // F2: extrato importado + lotes de importação
  transactions  BankTransaction[]
  importBatches ImportBatch[]

  @@index([companyId, isActive])
  @@map("bank_accounts")
}

model Acquirer {
  id                    String   @id @default(uuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id])
  name                  String
  bankKeywords          String[]
  debitRate             Decimal  @default(0) @db.Decimal(6, 4)
  creditRate            Decimal  @default(0) @db.Decimal(6, 4)
  creditInstallmentRate Decimal? @db.Decimal(6, 4)
  installmentRates      Json?
  settlementDaysDebit   Int      @default(1)
  settlementDaysCredit  Int      @default(30)
  anticipates           Boolean  @default(false)
  defaultBankAccountId  String?
  isActive              Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cardReceivables CardReceivable[]
  Payment         Payment[]

  @@index([companyId, isActive])
  @@map("acquirers")
}

model CashRegister {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())

  sessions CashSession[]

  @@unique([companyId, name])
  @@map("cash_registers")
}

model CashSession {
  id         String            @id @default(uuid())
  companyId  String
  company    Company           @relation(fields: [companyId], references: [id])
  registerId String
  register   CashRegister      @relation(fields: [registerId], references: [id])
  status     CashSessionStatus @default(OPEN)

  openedById     String
  openedBy       User     @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  openedAt       DateTime @default(now())
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)

  closedById   String?
  closedBy     User?     @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  closedAt     DateTime?
  expectedCash Decimal?  @db.Decimal(14, 2)
  countedCash  Decimal?  @db.Decimal(14, 2)
  difference   Decimal?  @db.Decimal(14, 2)
  closingNotes String?
  summary      Json?

  movements CashMovement[]
  payments  Payment[]

  @@index([companyId, status])
  @@index([registerId, status])
  @@map("cash_sessions")
}

model CashMovement {
  id            String             @id @default(uuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id])
  sessionId     String
  session       CashSession        @relation(fields: [sessionId], references: [id])
  type          CashMovementType
  direction     CashDirection
  amount        Decimal            @db.Decimal(14, 2) // sempre positivo (CHECK no SQL)
  description   String
  occurredAt    DateTime           @default(now())
  categoryId    String?
  category      FinancialCategory? @relation(fields: [categoryId], references: [id])
  paymentId     String?            @unique
  payment       Payment?           @relation(fields: [paymentId], references: [id])
  expenseId     String?            @unique
  expense       Expense?           @relation(fields: [expenseId], references: [id])
  bankAccountId String?
  isReconciled  Boolean            @default(false)
  reconciledAt  DateTime?
  createdById   String
  createdBy     User               @relation("CashMovementCreatedBy", fields: [createdById], references: [id])
  voidedAt      DateTime?
  voidedById    String?
  voidedBy      User?              @relation("CashMovementVoidedBy", fields: [voidedById], references: [id])
  voidReason    String?
  BankAccount   BankAccount?       @relation(fields: [bankAccountId], references: [id])
  // F2: conciliações deste movimento
  reconciliations Reconciliation[]

  @@index([sessionId, voidedAt])
  @@index([companyId, occurredAt])
  @@map("cash_movements")
}

model OtherIncome {
  id            String             @id @default(uuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id])
  description   String
  amount        Decimal            @db.Decimal(14, 2)
  receivedAt    DateTime           @db.Date
  categoryId    String?
  category      FinancialCategory? @relation(fields: [categoryId], references: [id])
  bankAccountId String?
  notes         String?
  source        EntrySource        @default(MANUAL)
  isReconciled  Boolean            @default(false)
  reconciledAt  DateTime?
  createdById   String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  BankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  // F2: conciliações desta receita
  reconciliations Reconciliation[]

  @@index([companyId, receivedAt])
  @@map("other_incomes")
}

model CardReceivable {
  id                String    @id @default(uuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  paymentId         String
  payment           Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  acquirerId        String
  acquirer          Acquirer  @relation(fields: [acquirerId], references: [id])
  installmentNumber Int
  installmentTotal  Int
  grossAmount       Decimal   @db.Decimal(14, 2)
  feeAmount         Decimal   @db.Decimal(14, 2)
  netAmount         Decimal   @db.Decimal(14, 2)
  expectedDate      DateTime  @db.Date
  isReconciled      Boolean   @default(false)
  reconciledAt      DateTime?
  // F2: conciliações deste recebível de cartão
  reconciliations   Reconciliation[]

  @@unique([paymentId, installmentNumber])
  @@index([companyId, isReconciled, expectedDate])
  @@map("card_receivables")
}

// =============================================
// FASE 2 — Importação OFX + conciliação
// Modelos conforme spec FINANCEIRO_IMPLEMENTACAO.md §7 (linhas 687-847).
// creditCardId/invoiceId (F3) ficam fora desta migration.
// =============================================

model ImportBatch {
  id            String       @id @default(uuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  kind          ImportKind   @default(BANK_STATEMENT)
  format        ImportFormat @default(OFX)
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

  fileName    String
  fileSize    Int
  fileHash    String // sha256 do conteúdo original
  storageKey  String? // null após purga por retenção
  status      ImportStatus @default(UPLOADED)
  parserId    String? // ex.: "ofx-v1"
  invertSigns Boolean      @default(false)

  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date
  statementStartBalance Decimal? @db.Decimal(14, 2)
  statementEndBalance   Decimal? @db.Decimal(14, 2)
  computedEndBalance    Decimal? @db.Decimal(14, 2)
  balanceCheck BalanceCheck @default(UNAVAILABLE)

  totalRows     Int @default(0)
  newRows       Int @default(0)
  duplicateRows Int @default(0)
  warnings      Json? // string[]
  errorMessage  String?

  uploadedById  String
  uploadedBy    User       @relation("ImportUploadedBy", fields: [uploadedById], references: [id])
  confirmedById String?
  confirmedBy   User?      @relation("ImportConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  rows         ImportRow[]
  transactions BankTransaction[]

  @@index([companyId, status, createdAt])
  @@index([companyId, fileHash])
  @@map("import_batches")
}

model ImportRow {
  // staging: linha lida, ainda não confirmada
  id       String      @id @default(uuid())
  batchId  String
  batch    ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowIndex Int
  postedAt DateTime    @db.Date
  amount   Decimal     @db.Decimal(14, 2) // com sinal (+ entrada, − saída)
  description    String
  memo           String?
  externalId     String? // FITID
  dedupeKey      String
  normalizedDescription String
  inferredMethod BankTxMethod @default(OTHER)
  installmentNumber Int?
  installmentTotal  Int?
  raw            Json? // linha/valores originais p/ auditoria
  isDuplicate       Boolean @default(false)
  possibleDuplicate Boolean @default(false)
  isIgnored         Boolean @default(false)
  warnings          String[]

  @@unique([batchId, rowIndex])
  @@index([batchId, isDuplicate])
  @@index([batchId, isIgnored])
  @@map("import_rows")
}

model BankTransaction {
  id            String       @id @default(uuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  bankAccountId String
  bankAccount   BankAccount  @relation(fields: [bankAccountId], references: [id])
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])
  source        BankTxSource

  dedupeKey          String // "F:<FITID>" ou "H:<sha256>"
  externalId         String?
  postedAt           DateTime     @db.Date
  amount             Decimal      @db.Decimal(14, 2) // com sinal
  description        String
  normalizedDescription String
  memo               String?
  counterpartyName   String?
  inferredMethod     BankTxMethod @default(OTHER)

  status           ReconStatus @default(PENDING)
  reconciledAmount Decimal     @default(0) @db.Decimal(14, 2)
  categoryId       String?
  category         FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  notes            String?
  transferPairId   String?
  transferPair     BankTransaction?  @relation("TransferPair", fields: [transferPairId], references: [id])
  transferPairOf   BankTransaction[] @relation("TransferPair")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reconciliations Reconciliation[]

  @@unique([bankAccountId, dedupeKey])
  @@index([companyId, bankAccountId, postedAt])
  @@index([companyId, status, postedAt])
  @@map("bank_transactions")
}

model Reconciliation {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  bankTransactionId String
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  targetType        ReconTargetType

  paymentId        String?
  payment          Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  cardReceivableId String?
  cardReceivable   CardReceivable? @relation(fields: [cardReceivableId], references: [id], onDelete: SetNull)
  expenseId        String?
  expense          Expense?        @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  otherIncomeId    String?
  otherIncome      OtherIncome?    @relation(fields: [otherIncomeId], references: [id], onDelete: SetNull)
  cashMovementId   String?
  cashMovement     CashMovement?   @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)
  pairTransactionId String? // TRANSFER: outra perna da transferência

  amount   Decimal     @db.Decimal(14, 2) // parte aplicada (> 0)
  score    Int?
  origin   ReconOrigin
  createdById String?
  createdAt   DateTime   @default(now())

  @@index([companyId, bankTransactionId])
  @@index([companyId, targetType])
  @@map("reconciliations")
}

model ReconciliationRule {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  priority  Int      @default(100) // menor = roda primeiro
  matchType RuleMatchType
  pattern   String
  direction RuleDirection @default(ANY)
  minAmount Decimal?      @db.Decimal(14, 2)
  maxAmount Decimal?      @db.Decimal(14, 2)
  bankAccountId String?
  action       RuleAction
  categoryId   String?
  category     FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId   String?
  supplier     Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  entryDescription String? // template p/ CREATE_ENTRY: "Tarifa bancária"
  isActive Boolean @default(true)
  hitCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, isActive, priority])
  @@map("reconciliation_rules")
}
